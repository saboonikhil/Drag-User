<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/app_name"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:src="@drawable/ic_main_logo" />

        <TextView
            android:id="@+id/main_title"
            style="@style/TextStyle23"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingBottom="4dp"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/main_notifications"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:contentDescription="@string/notifications"
            app:srcCompat="@drawable/ic_notifications" />

    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/main_nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:scrollingCache="true">

            <FrameLayout
                android:id="@+id/main_content_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="72dp" />

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white_three"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#05989898" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white_three"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/main_trips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/main_trips_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/trips"
                        app:srcCompat="@drawable/ic_trips" />

                    <TextView
                        android:id="@+id/main_trips_title"
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trips" />

                </LinearLayout>

                <View
                    android:layout_width="?attr/actionBarSize"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:id="@+id/main_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/main_account_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/account"
                        app:srcCompat="@drawable/ic_account" />

                    <TextView
                        android:id="@+id/main_account_title"
                        style="@style/TextStyle11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/main_book_ride"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:background="@android:color/transparent"
            android:contentDescription="@string/book_ride"
            android:src="@drawable/ic_book_ride" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>