                tools:text="IIT Kharagpur" />

            <ImageView
                android:id="@+id/select_cab_path"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ic_path"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/select_cab_drop"
                style="@style/TextStyle21"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/select_cab_path"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                tools:text="Kolkata Airport" />

        </RelativeLayout>

        <ImageButton
            android:id="@+id/select_cab_expanded_close"
