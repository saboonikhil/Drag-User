    <RelativeLayout
        android:id="@+id/select_cab_empty_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/select_cab_empty_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/no_cabs_available_now"
            app:srcCompat="@drawable/ic_empty_select" />

        <TextView
            android:id="@+id/select_cab_empty_message1"
            style="@style/TextStyle16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/select_cab_empty_image"
            android:layout_marginTop="32dp"
            android:text="@string/no_cabs_available_now" />

        <TextView
            android:id="@+id/select_cab_empty_message2"
            style="@style/TextStyle8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/select_cab_empty_message1"
            android:layout_centerInParent="true"
            android:layout_marginTop="16dp"
