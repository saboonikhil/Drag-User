            <TextView
                style="@style/TextStyle21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/select_cab"
                android:textSize="18sp" />

            <TextView
                style="@style/TextStyle11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/swipe_up_to_see_more" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/select_cab_collapsed_close"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_close"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/select_cab_expanded_action_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_below="@+id/select_cab_collapsed_action_bar"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/select_cab_pickup"
                style="@style/TextStyle21"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toStartOf="@+id/select_cab_path"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
